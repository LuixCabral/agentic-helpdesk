# ─── OpenRouter (LLM dos agentes) ────────────────────────────────────────────
# Gere sua chave em: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# ─── Jira ────────────────────────────────────────────────────────────────────
# URL da sua instância Atlassian (sem barra no final)
JIRA_URL=https://your-company.atlassian.net

# E-mail associado à sua conta Atlassian
JIRA_EMAIL=you@example.com

# Gere um API token em:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token

# Chave do projeto Jira onde os bugs serão criados (ex: PROJ, DEV, QA)
JIRA_PROJECT_KEY=PROJ

# ─── PostgreSQL (histórico de sessões da API) ─────────────────────────────────
# Credenciais centralizadas: usadas pelo docker-compose E pela API via DATABASE_URL.
# Em produção, substitua todos os valores abaixo pelas credenciais reais.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=bug_reporter

# Driver assíncrono psycopg v3. Deve referenciar as mesmas credenciais acima.
DATABASE_URL=postgresql+psycopg_async://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ─── Notion ───────────────────────────────────────────────────────────────────
# Token de integração da API do Notion.
# Crie uma integração em: https://www.notion.so/my-integrations
# Depois compartilhe as páginas/bancos de dados relevantes com a integração.
NOTION_API_TOKEN=secret_your-notion-integration-token

# (Opcional) ID da página raiz da documentação do Agenda Vix (Admin).
# Quando definido, o DocsAgent pode chamar list_child_pages() sem page_id
# para navegar na árvore de documentação a partir da raiz.
# Você encontra o ID na URL: notion.so/<workspace>/<titulo-da-pagina>-<PAGE_ID>
NOTION_ROOT_PAGE_ID=your-root-page-id-here

# ─── Redis (Rate Limiting) ────────────────────────────────────────────────────
# Senha obrigatória do Redis. Gerada via: openssl rand -hex 32
# Deve ser a mesma usada em REDIS_URL abaixo e no docker-compose.
REDIS_PASSWORD=your-strong-redis-password

# URL de conexão com o Redis usado pelo rate limiter.
# Formato com autenticação: redis://:<REDIS_PASSWORD>@<host>:<port>
# Com docker-compose (hostname = nome do serviço): redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Limite de requisições por IP para o endpoint POST /api/chat.
# Formato: "N/period" — exemplos: "10/minute", "100/hour", "5/second"
RATE_LIMIT_CHAT=10/minute

# IPs/CIDRs dos proxies reversos confiáveis (separados por vírgula).
# "127.0.0.1" = sem proxy (padrão local). Em produção com nginx: "127.0.0.1".
# Em produção com AWS ALB: adicione o CIDR do balanceador.
TRUSTED_PROXY_IPS=127.0.0.1

# ─── Autenticação da API ──────────────────────────────────────────────────────
# Chave de acesso obrigatória para o endpoint POST /api/chat.
# O cliente deve enviar no header: X-API-Key: <valor>
# Gere uma chave segura com: openssl rand -hex 32
API_KEY=your-strong-api-key-here
